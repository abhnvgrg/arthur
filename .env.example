# Copy to .env and fill in. Nothing here is read automatically -
# load it with your shell, or set the variables in Windows.
#
#   PowerShell, one session:   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#   Windows, permanently:      setx ARTHUR_LLM_API_KEY "gsk_..."

# ---------------------------------------------------------------- the model
# Groq gives you the chat model, speech-to-text and text-to-speech on one key.
ARTHUR_LLM_API_KEY=PUT_YOUR_GROQ_API_KEY_HERE
ARTHUR_LLM_BASE_URL=https://api.groq.com/openai/v1
# Model ids change often, and not every account can reach every model.
# Check what yours can use before setting this:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $ARTHUR_LLM_API_KEY"
# Leave it commented out to keep whatever you already have set on the machine.
ARTHUR_LLM_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------- her voice
ARTHUR_TTS_VOICE=diana
ARTHUR_WAKE_WORD=diana
# Off means she answers anything she hears. On means she waits to be named.
ARTHUR_REQUIRE_WAKE=1
# Only turn this on with headphones - on speakers she hears herself and stops.
ARTHUR_BARGE_IN=0
# Everything is approved by voice, including irreversible actions.
ARTHUR_SPOKEN_APPROVALS=1
# Irreversible actions need this exact word - a plain 'yes' will not do.
# Pick something you would never say by accident.
ARTHUR_CONFIRM_WORD=confirm
# Set to 1 to put typed approval back for irreversible actions only.
ARTHUR_TYPED_IRREVERSIBLE=0

# ---------------------------------------------------------------- the hub
ARTHUR_HOST=127.0.0.1
ARTHUR_PORT=8765
ARTHUR_TIMEZONE=Asia/Kolkata
# Where the phone reaches this machine. Set it once Tailscale is running,
# so approval buttons in push notifications have somewhere to post back to.
ARTHUR_PUBLIC_URL=http://your-laptop-name:8765
# A token with the approve scope, minted from the web UI. Used only by the
# Approve/Deny buttons in push notifications.
ARTHUR_APPROVE_TOKEN=PUT_AN_APPROVE_SCOPED_TOKEN_HERE

# ---------------------------------------------------------------- push
# ntfy.sh needs no account. Pick a long, unguessable topic - anyone who
# knows it can read your notifications.
ARTHUR_NTFY_TOPIC=PUT_A_LONG_RANDOM_TOPIC_HERE
ARTHUR_TOAST=1

# ---------------------------------------------------------------- mail
# Gmail: turn on 2-step verification, then create an App Password.
# Your normal password will not work.
ARTHUR_IMAP_HOST=imap.gmail.com
ARTHUR_IMAP_PORT=993
ARTHUR_IMAP_USER=you@gmail.com
ARTHUR_IMAP_PASSWORD=PUT_YOUR_16_CHARACTER_APP_PASSWORD_HERE
ARTHUR_IMAP_FOLDER=INBOX
ARTHUR_IMAP_ARCHIVE=[Gmail]/All Mail
ARTHUR_IMAP_DRAFTS=[Gmail]/Drafts

ARTHUR_SMTP_HOST=smtp.gmail.com
ARTHUR_SMTP_PORT=465
ARTHUR_SMTP_FROM=you@gmail.com

# ---------------------------------------------------------------- memory
# She writes down lasting facts about you after each exchange.
ARTHUR_AMBIENT_MEMORY=1

# ---------------------------------------------------------------- where things live
# Defaults are all under ~/.arthur - set these only to move them.
# ARTHUR_TASKS_FILE=
# ARTHUR_JOBS_FILE=
# ARTHUR_SESSIONS_FILE=
# ARTHUR_MEMORY_FILE=
